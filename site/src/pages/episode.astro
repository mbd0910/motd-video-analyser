---
import Base from '../layouts/Base.astro';
import { R2_BASE_URL } from '../config';
---

<Base title="Episode">
  <div id="back">
    <a href="/">&larr; All episodes</a>
  </div>

  <div id="episode">
    <p class="loading">Loading episode&hellip;</p>
  </div>
</Base>

<script define:vars={{ R2_BASE_URL }}>
  const container = document.getElementById('episode');
  const params = new URLSearchParams(window.location.search);
  const episodeId = params.get('id');

  if (!episodeId) {
    container.innerHTML = '<p class="error">No episode ID provided.</p>';
  } else {
    loadEpisode(episodeId);
  }

  function segmentDuration(seg) {
    if (!seg || !seg.start || !seg.end) return null;
    const parse = (ts) => {
      const p = ts.split(':').map(Number);
      if (p.length === 3) return p[0] * 3600 + p[1] * 60 + p[2];
      if (p.length === 2) return p[0] * 60 + p[1];
      return 0;
    };
    const secs = parse(seg.end) - parse(seg.start);
    if (secs <= 0) return null;
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  async function loadEpisode(id) {
    try {
      const res = await fetch(`${R2_BASE_URL}/episodes/${id}.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const ep = await res.json();

      const date = new Date(ep.broadcast_date + 'T00:00:00');
      const formatted = date.toLocaleDateString('en-GB', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });

      document.title = `${formatted} | Tough Place to Go`;

      const matches = (ep.matches ?? []).sort((a, b) => a.order - b.order);

      const rows = matches.map((m) => {
        const hlDur = segmentDuration(m.segments?.highlights);
        const studioDur = segmentDuration(m.segments?.studio_analysis);
        return `
          <tr>
            <td class="order">${m.order}</td>
            <td class="fixture">
              <span class="teams">${m.home_team} v ${m.away_team}</span>
              <span class="score">${m.score.home}&ndash;${m.score.away}</span>
            </td>
            <td class="venue">${m.venue}</td>
            <td class="duration">${hlDur ?? '&mdash;'}</td>
            <td class="duration">${studioDur ?? '&mdash;'}</td>
            ${m.notes ? `<td class="notes">${m.notes}</td>` : '<td class="notes">&mdash;</td>'}
          </tr>
        `;
      }).join('');

      container.innerHTML = `
        <h1>${formatted}</h1>
        <p class="meta">Season ${ep.season} &middot; ${matches.length} match${matches.length !== 1 ? 'es' : ''}</p>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Match</th>
                <th>Venue</th>
                <th>Highlights</th>
                <th>Studio</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              ${rows}
            </tbody>
          </table>
        </div>
      `;
    } catch (err) {
      container.innerHTML = '<p class="error">Failed to load episode. Please try again later.</p>';
      console.error('Failed to load episode:', err);
    }
  }
</script>

<style>
  #back {
    margin-bottom: 1.5rem;
  }

  #back a {
    font-size: 0.9rem;
  }

  .loading,
  .error {
    color: var(--muted);
    padding: 2rem 0;
  }

  .error {
    color: #b91c1c;
  }
</style>

<style is:global>
  #episode h1 {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  #episode .meta {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #episode table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  #episode th {
    text-align: left;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--border);
    white-space: nowrap;
  }

  #episode td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  #episode .order {
    text-align: center;
    font-weight: 600;
    color: var(--muted);
  }

  #episode .fixture {
    white-space: nowrap;
  }

  #episode .teams {
    font-weight: 500;
  }

  #episode .score {
    margin-left: 0.5rem;
    color: var(--muted);
  }

  #episode .venue {
    color: var(--muted);
    font-size: 0.9rem;
  }

  #episode .duration {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  #episode .notes {
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 12rem;
  }

  @media (max-width: 640px) {
    #episode table {
      font-size: 0.85rem;
    }

    #episode th,
    #episode td {
      padding: 0.4rem 0.5rem;
    }

    #episode .venue,
    #episode .notes {
      display: none;
    }
  }
</style>
