# Copy to .env and fill in. The CLI loads it from the working directory on start-up;
# variables already set in the environment win.

# --- Analysis (required) ---
# Claude API key for the analyse stage. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Publishing (required for `motd publish`) ---
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Speech-to-text (only for `motd transcribe`, the standalone Whisper path) ---
# Not needed when subtitles are available, which is the normal route.
OPENAI_API_KEY=
